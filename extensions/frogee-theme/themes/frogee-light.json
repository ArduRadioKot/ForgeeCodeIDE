  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#7d8a7f"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#2e7a3c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#a35f00"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#0f6a7a"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#0f6a7a"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#121713"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#3f6b1f"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#8a5a00"
      }
    },
    {
      "scope": "entity.name.class",
      "settings": {
        "foreground": "#8a5a00"
      }
    },
    {
      "scope": "variable.other.property",
      "settings": {
        "foreground": "#3e4a40"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#0f6a7a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#3f6b1f"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#147889"
      }
    },
    {
      "scope": "meta.decorator",
      "settings": {
        "foreground": "#a3501f"
      }
    }
  ]
}
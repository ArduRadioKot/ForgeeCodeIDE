    "editorWidget.background": "#ffffff",
    "panel.background": "#f8faf4",
    "panel.border": "#d6ded3",
    "sideBar.border": "#d6ded3",
    "editorGroup.border": "#d6ded3",
    "descriptionForeground": "#4f5a50",
    "foreground": "#121713",
    "editorLineNumber.foreground": "#9aa69b",

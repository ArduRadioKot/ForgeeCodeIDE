    "textLink.foreground": "#147889",
    "editor.selectionBackground": "#14788930",
    "editorCursor.foreground": "#147889",
    "editorError.foreground": "#e8482c",
    "editorWarning.foreground": "#a35f00",
    "gitDecoration.addedResourceForeground": "#2e8a3c",

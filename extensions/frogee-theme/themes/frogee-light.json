    "terminal.foreground": "#121713",
    "terminal.ansiBlack": "#121713",
    "terminal.ansiRed": "#e8482c",
    "terminal.ansiGreen": "#2e8a3c",
    "terminal.ansiYellow": "#a35f00",
    "terminal.ansiBlue": "#147889",
    "terminal.ansiMagenta": "#8a3fb0",
    "terminal.ansiCyan": "#0f6a7a",
    "terminal.ansiWhite": "#d6ded3",
    "terminal.ansiBrightBlack": "#4f5a50",
    "terminal.ansiBrightRed": "#f0664d",
    "terminal.ansiBrightGreen": "#3fae3b",
    "terminal.ansiBrightYellow": "#c07a10",
    "terminal.ansiBrightBlue": "#1b95a9",
    "terminal.ansiBrightMagenta": "#a75ccc",
    "terminal.ansiBrightCyan": "#1a8a9c",
    "terminal.ansiBrightWhite": "#ffffff"

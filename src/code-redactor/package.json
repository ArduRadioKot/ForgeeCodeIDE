{
  "name": "FrogeeCodeIDE",
  "version": "2.5.0",
  "description": "A modern code editor with AI chat integration, built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "build": "node scripts/run-builder.js --publish=never",
    "build:mac": "node scripts/run-builder.js --mac --publish=never",
    "build:win": "node scripts/run-builder.js --win --publish=never",
    "build:linux": "node scripts/run-builder.js --linux --publish=never",
    "build:all": "node scripts/run-builder.js --mac --win --linux --publish=never",
    "dist": "npm run build"
  },
  "keywords": [
    "electron",
    "code-editor",
    "ai-chat",
    "markdown",
    "openrouter",
    "ollama"
  ],
  "author": "arduradiokot <frogeesoft.team@gmail.com>",
  "homepage": "https://github.com/ArduRadioKot/ForgeeCodeIDE",
  "license": "GPL-2.0",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.0",
    "marked": "^9.1.6",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.arduradiokot.frogeecodeide",
    "productName": "FrogeeCodeIDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "lib/kernel_worker.py",
      "**/kernel_worker.py"
    ],
    "extraResources": [
      {
        "from": "lib/kernel_worker.py",
        "to": "kernel_worker.py"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "images/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "FrogeeCodeIDE"
    }
  }
}